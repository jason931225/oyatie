load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

_FIXUP = "third-party//fixups/dependency-declarations-generation-reindeer:fixups.toml"
_PACKAGE_VIEW = ["//build/dependency-declarations/adapters/generation-reindeer/..."]

rust_binary(
    name = "dependency-declarations-generation-reindeer-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

export_file(
    name = "build.rs",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

genrule(
    name = "dependency-declarations-generation-reindeer-source-items",
    srcs = glob(["src/items/*.rs"]),
    out = "source_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

genrule(
    name = "dependency-declarations-generation-reindeer-manifest-dir",
    srcs = [
        ":build.rs",
        ":dependency-declarations-generation-reindeer-source-items",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/src/items && cp $(location :build.rs) $OUT/ && cp -R $(location :dependency-declarations-generation-reindeer-source-items)/. $OUT/src/items/",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

buildscript_run(
    name = "dependency-declarations-generation-reindeer-build-script-run",
    buildscript_rule = ":dependency-declarations-generation-reindeer-build-script",
    package_name = "dependency-declarations-generation-reindeer",
    version = "0.1.0",
    manifest_dir = ":dependency-declarations-generation-reindeer-manifest-dir",
    within_view = _PACKAGE_VIEW,
)

_BUILD_ENV = {
    "OUT_DIR": "$(location :dependency-declarations-generation-reindeer-build-script-run[out_dir])",
}

rust_library(
    name = "dependency-declarations-generation-reindeer",
    srcs = glob(["src/**/*.rs"]),
    crate = "dependency_declarations_generation_reindeer",
    crate_root = "src/lib.rs",
    env = _BUILD_ENV,
    visibility = ["//build/dependency-declarations/..."],
    within_view = [
        "//build/dependency-declarations/adapters/generation-reindeer/...",
        "//build/dependency-declarations/core/reconcile/...",
        "//build/dependency-declarations/ports/generation/...",
    ],
    deps = [
        "//build/dependency-declarations/core/reconcile:dependency-declarations-reconcile",
        "//build/dependency-declarations/ports/generation:dependency-declarations-generation",
    ],
)

