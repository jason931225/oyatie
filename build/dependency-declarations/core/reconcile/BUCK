load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

_FIXUP = "third-party//fixups/dependency-declarations-reconcile:fixups.toml"
_PACKAGE_VIEW = ["//build/dependency-declarations/core/reconcile/..."]

rust_binary(
    name = "dependency-declarations-reconcile-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

export_file(
    name = "build.rs",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

genrule(
    name = "dependency-declarations-reconcile-source-items",
    srcs = glob(["src/items/*.rs"]),
    out = "source_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

genrule(
    name = "dependency-declarations-reconcile-manifest-dir",
    srcs = [
        ":build.rs",
        ":dependency-declarations-reconcile-source-items",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/src/items && cp $(location :build.rs) $OUT/ && cp -R $(location :dependency-declarations-reconcile-source-items)/. $OUT/src/items/",
    visibility = [],
    within_view = _PACKAGE_VIEW,
)

buildscript_run(
    name = "dependency-declarations-reconcile-build-script-run",
    buildscript_rule = ":dependency-declarations-reconcile-build-script",
    package_name = "dependency-declarations-reconcile",
    version = "0.1.0",
    manifest_dir = ":dependency-declarations-reconcile-manifest-dir",
    within_view = _PACKAGE_VIEW,
)

_BUILD_ENV = {
    "OUT_DIR": "$(location :dependency-declarations-reconcile-build-script-run[out_dir])",
}

rust_library(
    name = "dependency-declarations-reconcile",
    srcs = glob(["src/**/*.rs"]),
    crate = "dependency_declarations_reconcile",
    crate_root = "src/lib.rs",
    env = _BUILD_ENV,
    visibility = [
        "//build/dependency-declarations/...",
        "//pipeline/facade/path-layout-app:pipeline-path-layout-app",
    ],
    within_view = [
        "//build/dependency-declarations/core/reconcile/...",
        "//build/dependency-declarations/ports/generation/...",
        "//build/dependency-declarations/ports/publication/...",
        "third-party//:semver",
        "third-party//:sha2",
        "third-party//:toml",
    ],
    deps = [
        "//build/dependency-declarations/ports/generation:dependency-declarations-generation",
        "//build/dependency-declarations/ports/publication:dependency-declarations-publication",
        "third-party//:semver",
        "third-party//:sha2",
        "third-party//:toml",
    ],
)

rust_test(
    name = "dependency-declarations-reconcile-repository-manifests-test",
    srcs = ["tests/repository_manifests.rs"],
    crate = "dependency_declarations_reconcile_repository_manifests_test",
    crate_root = "tests/repository_manifests.rs",
    visibility = [],
    within_view = _PACKAGE_VIEW,
    deps = [":dependency-declarations-reconcile"],
)

rust_test(
    name = "dependency-declarations-reconcile-execution-toolchain-transition-test",
    srcs = [
        "tests/execution_toolchain_transition.rs",
        "tests/execution_toolchain_transition/analysis.rs",
        "tests/execution_toolchain_transition/nightly_channel.rs",
        "tests/execution_toolchain_transition/patch_policy.rs",
        "tests/execution_toolchain_transition/support.rs",
    ],
    crate = "dependency_declarations_reconcile_execution_toolchain_transition_test",
    crate_root = "tests/execution_toolchain_transition.rs",
    visibility = [],
