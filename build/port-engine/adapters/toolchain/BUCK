# Package-local corpus mirrors build/toolchains/** (dual-home) as *.txt so include_str! stays
# hermetic under buck2 (nested files named BUCK are excluded from rust srcs globs).
# Cell remap (.buckconfig) remains PARKED outside roots.build; this axis digests dual-home bytes.
rust_library(
    name = "port-engine-toolchain",
    srcs = glob(["src/**/*.rs", "src/corpus/**/*.txt"]),
    crate = "port_engine_toolchain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/hash:port-engine-hash",
        "//build/port-engine/ports/api:port-engine-api",
    ],
)

rust_test(
    name = "port-engine-toolchain-unittest",
    srcs = glob(["src/**/*.rs", "src/corpus/**/*.txt"]),
    crate = "port_engine_toolchain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/hash:port-engine-hash",
        "//build/port-engine/ports/api:port-engine-api",
    ],
)

rust_test(
    name = "port-engine-toolchain-readiness",
    srcs = glob(["tests/readiness.rs"]),
    crate = "port_engine_toolchain_readiness",
    crate_root = "tests/readiness.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":port-engine-toolchain",
    ],
)
