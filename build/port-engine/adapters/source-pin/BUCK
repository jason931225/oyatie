    srcs = glob(["src/**/*.rs", "src/**/*.json"]),
    crate = "port_engine_source_pin",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

