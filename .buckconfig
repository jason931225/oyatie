# rust-toolchain.toml is valid buckconfig syntax, so including it here makes
# `[toolchain] channel` readable via read_root_config. build/toolchains/rust.bzl derives
# the pinned Rust version from it rather than restating it, keeping rust-toolchain.toml
# the single statement of the toolchain version.
<file:rust-toolchain.toml>

[cells]
  root = .
  prelude = prelude
  toolchains = build/toolchains
  none = none
  third-party = third-party

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses a copy of the prelude bundled with the buck2 binary. You can alternatively delete this
# section and vendor a copy of the prelude to the `prelude` directory of your project.
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:third-party//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

# Bare-stock buck2 daemons default to a 4-day idle timeout, which lets stale
# daemons (one per worktree/branch checkout) accumulate and sprawl host RAM.
# These three keys are confirmed-recognized buck2 [buck2] section properties
# (verified against facebook/buck2 upstream source: app/buck2_common/src/init.rs
# for daemon_idle_timeout_s, app/buck2_execute_impl/.../clean_stale.rs for
# clean_stale_enabled, docs/users/advanced/restarter.md for restarter).
[buck2]
  daemon_idle_timeout_s = 14400
  clean_stale_enabled = true
  restarter = true

# Nested git worktrees live INSIDE the repo root, so buck2 parses their contents as packages
# of this cell. Verified 2026-07-26: `buck2 targets //...` FAILS with exit 3 ("Failed to parse
# 1 package") on a worktree's own buck-out/v2/external_cells/bundled/prelude/**/BUCK, which
# resolves against a different prelude version than this repo's. Whole-graph queries — build,
# test, and the `rdeps(//..., ...)` affected-set driver — are unusable until these are ignored.
# Measured on the canonical checkout: exit 3 / 0 targets / 45.8s before, exit 0 / 1851 targets
# / 1.3s after. Scale: 55,902 BUCK files under these roots against 940 tracked in the repo.
#
# The four roots are exactly the in-repo worktree parents (`git worktree list`). Agent
# directories (.claude, .codex, .cursor) are no longer tracked at all -- they exist locally
# because agent tools read them from fixed paths, but nothing in the build references them.
# The hooks they wire live in tools/hooks, which IS tracked.
# CI is unaffected — runners get a clean checkout with none of these roots present.
[project]
  ignore = .claude/worktrees, .worktrees, .gjc, .omx
