# Shared dependency sets. The spine's test targets nearly all take the
# same five edges; naming them once keeps this file inside the 300-line
# budget as the suite grows, and makes a genuine deviation visible as a
# deviation rather than as one more repeated block.
SPINE_CRATE_DEPS = [
    "//app/foundry/core/edits:foundry-edits",
    "//app/foundry/ports/draft/records:foundry-records-draft",
    "//data/core/data-boundary-kernel:data-boundary-kernel",
    "//data/core/ontology-kernel:data-ontology-kernel",
]

SPINE_TEST_DEPS = [":foundry-spine"] + SPINE_CRATE_DEPS

rust_library(
    name = "foundry-spine",
    srcs = glob(["src/**/*.rs"]),
    crate = "foundry_spine",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = SPINE_CRATE_DEPS + [
        "//app/foundry/ports/draft/audit:foundry-audit-draft",
        "//app/foundry/ports/draft/projection:foundry-projection-draft",
    ],
)

rust_test(
    name = "foundry-spine-unittest",
